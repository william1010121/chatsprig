{
  "manifest_version": 3,
  "name": "ChatSprig \u2014 Open ChatGPT, Claude, Gemini or Grok on Any Page",
  "version": "2.6.3",
  "description": "Open ChatGPT, Gemini, Claude and Grok chats in your current page, with keyboard shortcuts and selection-to-sidebar.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png",
    "32": "icons/icon32.png"
  },
  "permissions": [
    "storage",
    "cookies",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*",
    "https://claude.ai/*",
    "https://grok.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "ChatSprig Settings"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "allow_framing",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "commands": {
    "toggle-chat": {
      "suggested_key": {
        "default": "Alt+K",
        "mac": "Alt+K",
        "windows": "Alt+K"
      },
      "description": "Open / close the ChatGPT temporary chat overlay"
    },
    "refresh-chat": {
      "suggested_key": {
        "default": "Alt+N",
        "mac": "Alt+N",
        "windows": "Alt+N"
      },
      "description": "Reload the overlay with a fresh temporary chat"
    },
    "toggle-gemini": {
      "suggested_key": {
        "default": "Alt+G",
        "mac": "Alt+G",
        "windows": "Alt+G"
      },
      "description": "Open / close the Gemini temporary chat overlay"
    },
    "toggle-claude": {
      "description": "Open / close the Claude chat overlay"
    },
    "toggle-grok": {
      "description": "Open / close the Grok chat overlay"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/shortcuts.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://claude.ai/*",
        "https://grok.com/*"
      ],
      "js": [
        "content/frame-privacy-gate.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "shared/defaults.js",
        "content/overlay.js",
        "content/launcher.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "shared/defaults.js",
        "content/chat-context.js",
        "content/skill-completion.js",
        "content/btw.js",
        "content/branch-tree.js",
        "content/system-prompt.js",
        "content/frame-helper.js",
        "content/compact-view.js",
        "content/ask-sidebar.js",
        "content/explain-gemini.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "shared/defaults.js",
        "content/copy-latex.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "shared/defaults.js",
        "content/skill-completion.js",
        "content/gemini-frame-helper.js",
        "content/gemini-ask-sidebar.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://claude.ai/*",
        "https://grok.com/*"
      ],
      "js": [
        "shared/defaults.js",
        "content/assistant-frame-helper.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content/native-copy.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "short_name": "ChatSprig"
}
